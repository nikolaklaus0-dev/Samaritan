{
  "name": "klaus-xmd",
  "version": "5.0.0",
  "description": "KLAUS-XMD, a Multi Device WhatsApp Bot",
  "main": "./index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --no-warnings --max-old-space-size=512 index.js",
    "start": "pm2 start index.js --deep-monitoring --attach --name klausxmd",
    "heroku": "node --no-warnings --max-old-space-size=512 index.js",
    "stop": "pm2 stop klausxmd",
    "restart": "pm2 restart klausxmd && pm2 logs",
    "stash": "git stash && git stash drop"
  },
  "keywords": [
    "klaus",
    "klaus-xmd",
    "whatsapp-bot",
    "baileys"
  ],
  "author": "KLAUS",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "*",
    "@hapi/boom": "*",
    "@vitalets/google-translate-api": "^9.2.0",
    "acrcloud": "*",
    "adm-zip": "*",
    "audio-decode": "^2.2.3",
    "axios": "^1.2.5",
    "better-sqlite3": "^12.6.2",
    "body-parser": "latest",
    "buffer": "*",
    "dotenv": "*",
    "express": "^4.19.2",
    "ffmpeg-static": "*",
    "file-type": "17.1.6",
    "fluent-ffmpeg": "*",
    "form-data": "^4.0.1",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.1.0",
    "klaus-baileys": "npm:gifted-baileys@2.5.8",
